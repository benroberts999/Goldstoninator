# ignore everything ...
/*

# ... except the source, the notebook, and the docs
!.gitignore
!README.md
!LICENSE
!pyproject.toml
!requirements.txt
!*.ipynb

# the package (without Python's caches)
!goldstoninator/
__pycache__/

# example pictures shown in the README (regenerated by the notebook)
!img
!img/**

# "/*" ignores whole directories; to track one, add "!dir/" and "!dir/*"
